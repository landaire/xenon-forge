[cells]
  xbox360 = .
  prelude = prelude
  toolchains = toolchains
  none = none
  rustc_bootstrap = toolchain/buck2-rustc-bootstrap

[cell_aliases]
  config = prelude
  ovr_config = prelude
  fbcode = none
  fbsource = none
  buck = none

# The source-built PPC64 compiler comes from rustc_bootstrap.
[external_cells]
  prelude = bundled
  rustc_bootstrap = git

[external_cell_rustc_bootstrap]
  git_origin = https://github.com/landaire-contrib/buck2-rustc-bootstrap
  commit_hash = 02ee4260ced11b7d49c71445e10dd660cfebae84

[parser]
  target_platform_detector_spec = target:xbox360//...->prelude//platforms:default \
    target:prelude//...->prelude//platforms:default \
    target:toolchains//...->prelude//platforms:default

[build]
  execution_platforms = xbox360//platforms:execution

[project]
  ignore = .git, .jj, .tools, target, .rustsrc-backup

# Builds of this repository itself. A project that uses this cell sets
# `xbox360.mode` itself (or uses the mode files) and calls
# xbox360_modifiers() from its own root PACKAGE (buck/modes.bzl).
[xbox360]
  cfg_constructor = true
