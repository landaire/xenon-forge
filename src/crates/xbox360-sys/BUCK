rust_library(
    name = "xbox360-sys",
    srcs = glob(["src/**/*.rs"]),
    crate = "xbox360_sys",
    crate_root = "src/lib.rs",
    edition = "2024",
    # The thunk library of src/sdk, as build.rs gives it to Cargo builds.
    env = {"XBOX360_SDK_THUNKS": "$(location //src/sdk:thunks)"},
    visibility = ["PUBLIC"],
)

# Host tests of the modules that compile on every target.
rust_test(
    name = "xbox360-sys-test",
    srcs = glob(["src/**/*.rs"]),
    crate = "xbox360_sys",
    crate_root = "src/lib.rs",
    edition = "2024",
)
